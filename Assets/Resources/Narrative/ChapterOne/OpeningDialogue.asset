  m_Script: {fileID: 11500000, guid: 0e56b0faf2b1433e9168918629ac1cbb, type: 3}
  m_Name: OpeningDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - "\uAF2C\uB9F9\uC774, \uB208\uC744 \uB5B4\uAD6C\uB098. \uC9C0\uAE08\uC740 \uBE48\uC190\uC774\uC5B4\uB3C4 \uAD1C\uCC2E\uC544. \uD558\uB098\uC529 \uCC3E\uC544\uBCF4\uC790."
  - "\uBB3C\uAC74\uC740 \uD074\uB9AD\uD574\uC11C \uC0B4\uD3B4\uBCF4\uACE0, \uC591\uC606 \uD654\uC0B4\uD45C\uB85C \uBC29\uC744 \uB458\uB7EC\uBCF4\uB834. \uC800 \uD070 \uC0C1\uC790\uBD80\uD130 \uBC00\uC5B4 \uBCFC\uAE4C?"
  - "\uAC00\uBC29 \uC548\uC758 \uBB3C\uAC74\uC740 \uC62E\uAE30\uAC70\uB098 R\uB85C \uB3CC\uB9B4 \uC218 \uC788\uC5B4. \uC4F8 \uBB3C\uAC74\uC740 \uAC00\uBC29 \uC624\uB978\uCABD \uC704 \uC7A5\uCC29\uCE78\uC5D0 \uC62C\uB824 \uB450\uB834."
